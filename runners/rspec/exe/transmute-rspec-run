#!/usr/bin/env ruby
# frozen_string_literal: true

require 'json'
require 'socket'

# DEFAULT_SOCKET is intentionally duplicated from server.rb so this client
# binary depends only on Ruby stdlib (no `require 'transmute/rspec'`, no
# rspec-core transitive load). Keep in sync if the server default changes.
DEFAULT_SOCKET = '/tmp/transmute-rspec.sock'

socket_path = ENV['TRANSMUTE_RSPEC_SOCKET'] || DEFAULT_SOCKET
spec_path = ARGV[0]

if spec_path.nil? || spec_path.empty?
  warn 'usage: transmute-rspec-run <spec_file>'
  exit 2
end

open_socket =
  if socket_path.start_with?('tcp://')
    # tcp:// parsing is intentionally duplicated from Server.parse_tcp (server.rb)
    # for the same stdlib-only reason as DEFAULT_SOCKET above. The bracketed-IPv6
    # branch must stay in sync with that method (verified equivalent by its specs).
    host_port = socket_path.sub(%r{^tcp://}, '')
    if (match = host_port.match(/\A\[(?<host>.+)\]:(?<port>\d+)\z/))
      host = match[:host]
      port = match[:port]
    else
      host, _colon, port = host_port.rpartition(':')
    end
    ->(&block) { TCPSocket.open(host, Integer(port), &block) }
  else
    ->(&block) { UNIXSocket.open(socket_path, &block) }
  end

begin
  open_socket.call do |sock|
    sock.puts(JSON.generate({ action: 'run', spec: spec_path }))
    line = sock.gets
    if line.nil? || line.empty?
      warn "transmute-rspec-run: daemon at #{socket_path} closed the connection without responding"
      exit 2
    end

    begin
      response = JSON.parse(line)
    rescue JSON::ParserError => e
      warn "transmute-rspec-run: daemon response was not valid JSON: #{e.message}"
      exit 2
    end

    $stdout.write(response['stdout'].to_s)
    exit Integer(response['exit_code'] || 2)
  end
rescue Errno::ENOENT, Errno::ECONNREFUSED
  warn "transmute-rspec-run: daemon not reachable at #{socket_path}; start it with 'bundle exec transmute-rspec serve'"
  exit 2
rescue Errno::ECONNRESET, Errno::EPIPE => e
  warn "transmute-rspec-run: daemon at #{socket_path} died mid-response (#{e.class}); engine will treat as infra error, not killed mutation"
  exit 2
end
